{
  "name": "vrs-interpreter-desktop",
  "version": "1.0.0",
  "description": "SignBridge interpreter dashboard as a desktop app for Windows.",
  "main": "main.js",
  "author": "Milbert Barcelo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "org.careertechguam.vrs.interpreter",
    "productName": "SignBridge Interpreter",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SignBridge Interpreter"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
